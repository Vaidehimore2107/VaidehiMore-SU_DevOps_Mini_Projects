pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Install dependencies') {
            steps {
                sh 'python3 -m venv .venv'
                sh '.venv/bin/python -m pip install --upgrade pip'
                sh '.venv/bin/pip install -r requirements.txt'
            }
        }
        stage('Test') {
            steps {
                sh '.venv/bin/python -m pytest -q'
            }
        }
        stage('Docker build') {
            steps {
                sh 'docker build -t student-management:unit3 .'
            }
        }
    }
    post {
        always {
            echo 'Pipeline completed; review each stage result before reporting success.'
        }
    }
}
